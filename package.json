{
  "name": "@local/elderly-script",
  "version": "1.2.0",
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test tests/update-core.test.mjs",
    "release": "node scripts/release.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OuyangLing1999/Dsh-scriptForGin.git"
  },
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "skills/",
    "README.md",
    "UPSTREAM.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
