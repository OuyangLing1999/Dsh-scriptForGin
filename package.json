{
  "name": "@local/elderly-script",
  "version": "2.2.0",
  "devDependencies": { "zod": "4.4.3", "esbuild": "0.25.12", "playwright-core": "1.56.1" },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test tests/*.test.mjs",
    "release": "node scripts/release.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OuyangLing1999/Dsh-scriptForGin.git"
  },
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "result-projection.js",
    "workbench-core.js",
    "io-core.js",
    "update-core.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "skills/",
    "README.md",
    "UPSTREAM.md",
    "THIRD_PARTY_LICENSES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
